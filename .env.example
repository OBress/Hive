# Copy to .env and fill in. Never commit .env.

# Model provider: openai = any OpenAI-compatible API (Luminal), anthropic, or fake (scripted agents, no key)
LLM_PROVIDER=openai
LLM_API_KEY=                 # Luminal API key
LLM_BASE_URL=https://flash.luminal.cloud/v1   # Luminal (OpenAI-compatible)
AGENT_MODEL=                 # blank: deepseek-ai/DeepSeek-V4.1-Flash
PLANNER_MODEL=               # blank: deepseek-ai/DeepSeek-V4.1-Flash too
ANTHROPIC_API_KEY=           # only for LLM_PROVIDER=anthropic

# Limits
AGENT_MAX_TOKENS=            # blank: 8192 (64000 with anthropic); output room per agent reply
AGENT_CONTEXT_CHARS=         # blank: 300000 (1500000 with anthropic); transcript size before older steps are shortened
LLM_EXTRA_BODY=              # JSON merged into OpenAI-compatible requests, e.g. {"reasoning_effort":"high"}
MAX_PARALLEL=4               # agents running at once
LLM_CONCURRENCY=             # blank: MAX_PARALLEL; lower it if the provider rate-limits agent calls
MAX_STEPS=60                 # model replies per run before the task pauses
TEST_TIMEOUT_S=60            # one test run, seconds
REVIEW=on                    # off: merge finished tasks without the reviewer pass
NPM_ALLOW=                   # blank: a curated list (three, express, d3, ...); "*" any package; "off" no installs
AGENT_VISION=                # on: the agent model sees screenshots (default: only with anthropic)

# GitHub push on Approve (optional; blank = merge locally only)
GITHUB_REMOTE=               # https://github.com/<owner>/<repo>.git
GITHUB_TOKEN=                # fine-grained token, Contents: read and write, this repo only

# Supabase: sign-in with GitHub OAuth (blank = auth off, for local dev and fake mode)
SUPABASE_URL=                # https://<project>.supabase.co
SUPABASE_ANON_KEY=           # the project's anon (public) key

# Supabase storage: run server/supabase.sql, then set the server-only service role/secret key.
# Never expose this key to the browser. With Supabase configured, storage must connect successfully.
SUPABASE_SERVICE_ROLE_KEY=

# Daytona sandbox for running agent-written code (optional; blank = tests run on this machine)
DAYTONA_API_KEY=             # from https://app.daytona.io/dashboard/keys
DAYTONA_API_URL=             # blank: https://app.daytona.io/api
DAYTONA_TARGET=              # blank: the account's default region

# OpenCode server the agent searches files with. Not needed with Daytona (one runs in the sandbox);
# without it, start one here with `opencode serve`
OPENCODE_URL=                # e.g. http://127.0.0.1:4096

# Goal check (Semi-auto / Auto): screenshots of src/server.js or src/index.html
CHROME_PATH=                 # optional: Chrome or Edge is found in the usual places
VISION_MODEL=                # optional: a model that can see screenshots (Anthropic's planner can already)

PORT=4000
